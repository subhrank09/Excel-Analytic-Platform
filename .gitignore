# Ignore node_modules for both frontend and backend
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore build/dist directories
frontend/build/
backend/dist/

# Ignore environment variables
.env
.env.*  # optional, if you use .env.development, etc.
frontend/.env
backend/.env

# Ignore log files
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore OS system files
.DS_Store
Thumbs.db

# Ignore coverage reports
coverage/
frontend/coverage/
backend/coverage/

# Ignore IDE/editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Ignore runtime files
pids
*.pid
*.seed
*.pid.lock

# Misc build cache
.cache/
.parcel-cache/
.next/
out/
.eslintcache

# Ignore postcss/tailwind artifacts (optional)
postcss.config.js
tailwind.config.js
